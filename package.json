{
  "name": "actionseam",
  "version": "0.0.0-experimental",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Adversarial conformance testing for agent runtimes, action boundaries, transports, and committed effects.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node src/cli.js demo --subject reference --out artifacts/reference",
    "demo:bad": "node src/cli.js demo --subject known-bad --out artifacts/known-bad",
    "examples:check": "node examples/run-reference-suite.mjs && node examples/run-known-bad-profile.mjs",
    "validate": "node scripts/validate-repository.js",
    "security:scan-history": "node scripts/scan-public-history-secrets.js",
    "check": "npm test && npm run validate && npm run examples:check && npm run demo && npm run demo:bad"
  }
}
